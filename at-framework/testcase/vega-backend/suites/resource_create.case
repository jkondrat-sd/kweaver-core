-   name: "Negative_创建resource_dataset资源_缺少配置信息_请求失败"
    url: "创建resource"
    body_params: >-
        {
            "catalog_id": "${catalog_id}",
            "name": "{{ '新增resource_dataset-%s' | format(random_string(6, 8)) }}",
            "category": "dataset"
        }
    code_check: "400"

