-   name: "Positive_创建定时任务_任务禁用_请求成功"
    url: "创建调度任务"
    prev_case: "Positive_创建catalog_数据源_请求成功"
    body_params: >-
        {
            "name": "{{ '新增定时任务_Autocase-%s' | format(random_string(6, 8)) }}",
            "catalog_id": "${catalog_id}",
            "cron_expr": "00 08 * * *",
            "enabled": false
        }
    resp_values: >-
        {
            "scheduler_id": "$.id"
        }
    code_check: "201"

